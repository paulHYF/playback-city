# POLYV 直播开放接口（测试环境 develop-3）；appId/appSecret 可从测试库 application 表按频道归属用户查
POLYV_API_BASE=https://develop-3-api.polyv.net
POLYV_APP_ID=
POLYV_APP_SECRET=

# 大模型：任意 OpenAI 兼容接口，需支持 JSON 输出
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# 数据目录：raw 原始数据与生成的 game.json
DATA_DIR=./data
# 前端开发地址，逗号分隔
CORS_ORIGINS=http://localhost:5173
